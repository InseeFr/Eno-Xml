<?xml version="1.0" encoding="UTF-8"?>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format">
    <!-- courrier ImprimFIP -->
    <!-- courrier Coltrane v2/Platine -->
    <fo:layout-master-set>
        
        <fo:page-sequence-master master-name="entreeCOLT">
            <fo:repeatable-page-master-alternatives>
                <fo:conditional-page-master-reference master-reference="entreeCOLT-recto" odd-or-even="odd"/>
                <fo:conditional-page-master-reference master-reference="entreeCOLT-verso" odd-or-even="even"/>
            </fo:repeatable-page-master-alternatives>
        </fo:page-sequence-master>
        
        <fo:simple-page-master master-name="entreeCOLT-recto" font-family="Liberation Sans" font-size="10pt" font-weight="normal" page-height="297mm" page-width="210mm">
            <fo:region-body region-name="xsl-region-body" margin-top="10mm" margin-bottom="10mm" margin-right="10mm" margin-left="10mm" column-count="1"/>
            <fo:region-before region-name="xsl-region-before-courrier" display-align="before" extent="10mm" precedence="true"/>
            <fo:region-after region-name="xsl-region-after-cover" display-align="before" extent="10mm" precedence="true"/>
            <fo:region-start extent="10mm" display-align="before"/>
            <fo:region-end extent="10mm" display-align="before"/>
        </fo:simple-page-master>
        
        <fo:simple-page-master master-name="entreeCOLT-verso" font-family="Liberation Sans" font-size="10pt" font-weight="normal" page-height="297mm" page-width="210mm">
            <fo:region-body margin-top="10mm" margin-bottom="10mm" margin-right="10mm" margin-left="10mm" column-count="1"/>
            <fo:region-before region-name="xsl-region-before-cover" display-align="before" extent="10mm" precedence="true"/>
            <fo:region-after region-name="xsl-region-after-cover" display-align="before" extent="10mm" precedence="true"/>
            <fo:region-start extent="10mm" display-align="before"/>
            <fo:region-end extent="10mm" display-align="before"/>
        </fo:simple-page-master>
        
    </fo:layout-master-set>
    
    <fo:page-sequence font-family="Liberation Sans" font-size="8pt" master-reference="entreeCOLT">
        
        <!--  Variables obligatoires, non utilisées pour le rendu du PDF.
        Conservées dans le FO uniquement pour la génération du schéma XSD.
        Ne pas supprimer sans analyser l'impact sur la génération du XSD
        et les traitements qui en dépendent (ex. fichier plat).  -->        
        <fo:static-content flow-name="xsl-region-before-courrier">
            <fo:block position="absolute" margin-top="5mm" margin-left="10mm" margin-right="10mm" margin-bottom="10mm" font-size="5pt" color="white">
                ${Barcode} ${BddAdressePosteeL7}
            </fo:block>
        </fo:static-content>
        
        <fo:flow flow-name="xsl-region-body">
            
            <!-- PAGE COURRIER RECTO -->
            <fo:block page-break-after="always">
                
                #set($BddAdressePosteeL1 = ${BddAdressePosteeL1})
                #set($BddAdressePosteeL2 = ${BddAdressePosteeL2})
                #set($BddAdressePosteeL3 = ${BddAdressePosteeL3})
                #set($BddAdressePosteeL4 = ${BddAdressePosteeL4})
                #set($BddAdressePosteeL5 = ${BddAdressePosteeL5})
                #set($BddAdressePosteeL6 = ${BddAdressePosteeL6})
                
                <!-- Mise en place du REGEX pour chaque type de caractère accentué -->
                #set($RegexA = "[àáâãäåÀÁÂÃÄÅ@]")
                #set($RegexE = "[èéêëÈÉÊË]")
                #set($RegexI = "[ìíîïÌÍÎÏ]")
                #set($RegexO = "[òóôõöÒÓÔÕÖ]")
                #set($RegexU = "[ùúûüÙÚÛÜ]")
                #set($RegexY = "[ýÿÝ]")
                #set($RegexC = "[çÇ]")
                #set($RegexN = "[ñÑ]")
                
                <!-- Remplacement des caractères accentués par des caractères non accentués en minuscules car ensuite on fait un "uppercase" sur le bloc adresse -->
                #set($BddAdressePosteeL1 = $BddAdressePosteeL1.replaceAll($RegexA, 'a').replaceAll($RegexE, 'e').replaceAll($RegexI, 'i').replaceAll($RegexO, 'o').replaceAll($RegexU, 'u').replaceAll($RegexY, 'y').replaceAll($RegexC, 'c').replaceAll($RegexN, 'n'))
                #set($BddAdressePosteeL2 = $BddAdressePosteeL2.replaceAll($RegexA, 'a').replaceAll($RegexE, 'e').replaceAll($RegexI, 'i').replaceAll($RegexO, 'o').replaceAll($RegexU, 'u').replaceAll($RegexY, 'y').replaceAll($RegexC, 'c').replaceAll($RegexN, 'n'))
                #set($BddAdressePosteeL3 = $BddAdressePosteeL3.replaceAll($RegexA, 'a').replaceAll($RegexE, 'e').replaceAll($RegexI, 'i').replaceAll($RegexO, 'o').replaceAll($RegexU, 'u').replaceAll($RegexY, 'y').replaceAll($RegexC, 'c').replaceAll($RegexN, 'n'))
                #set($BddAdressePosteeL4 = $BddAdressePosteeL4.replaceAll($RegexA, 'a').replaceAll($RegexE, 'e').replaceAll($RegexI, 'i').replaceAll($RegexO, 'o').replaceAll($RegexU, 'u').replaceAll($RegexY, 'y').replaceAll($RegexC, 'c').replaceAll($RegexN, 'n'))
                #set($BddAdressePosteeL5 = $BddAdressePosteeL5.replaceAll($RegexA, 'a').replaceAll($RegexE, 'e').replaceAll($RegexI, 'i').replaceAll($RegexO, 'o').replaceAll($RegexU, 'u').replaceAll($RegexY, 'y').replaceAll($RegexC, 'c').replaceAll($RegexN, 'n'))
                #set($BddAdressePosteeL6 = $BddAdressePosteeL6.replaceAll($RegexA, 'a').replaceAll($RegexE, 'e').replaceAll($RegexI, 'i').replaceAll($RegexO, 'o').replaceAll($RegexU, 'u').replaceAll($RegexY, 'y').replaceAll($RegexC, 'c').replaceAll($RegexN, 'n')) 
                
                <!-- ZONE LOGO GAUCHE RF -->
                <fo:block-container absolute-position="absolute" left="7mm" top="6.65mm" width="30mm" height="25.35mm" overflow="hidden">
                    <fo:block>                        
                        <fo:external-graphic src="imprimFIP/Republique_Francaise_25_NB_100.jpg" height="25mm" content-width="scale-to-fit"/>                        
                    </fo:block>
                </fo:block-container>
                
                <!-- ZONE RESERVE IMPRIMFIP HAUT A DROITE -->
                <fo:block-container absolute-position="absolute" left="135mm" top="0mm" width="55mm" height="20mm" overflow="hidden">
                    <fo:block/>
                </fo:block-container> 
                
                <!-- CODIFICATION IMPRIMFIP -->
                <fo:block-container absolute-position="absolute" left="135mm" top="0mm" width="55mm" height="6.5mm" overflow="hidden">
                    <fo:block text-align="right" display-align="before" font-size="8pt" margin="2mm">IS_PLAE_ENT</fo:block>
                </fo:block-container>
                
                <!-- ZONE LOGOS DROITE INSEE SSM -->
                <fo:block-container absolute-position="absolute" right="7mm" top="5.65mm" width="85mm" height="14.35mm" overflow="hidden">
                    <fo:block text-align="right">
                        <fo:external-graphic src="imprimFIP/${Enq_ImageLogos}" height="14mm" content-width="scale-to-fit"/>
                    </fo:block>                                   
                </fo:block-container>
                
                <!-- ZONE RESERVE ADRESSE -->
                <fo:block-container absolute-position="absolute" left="70mm" top="20mm" width="117mm" height="60mm" overflow="hidden">
                    <fo:block/>
                </fo:block-container>    
                
                <!-- ZONE Expéditeur -->
                <fo:block-container absolute-position="absolute" left="91mm" top="25mm" width="92mm" height="14mm" overflow="hidden">
                    <fo:block/>
                </fo:block-container>                 
                
                <!-- ZONE ADRESSE -->
                <fo:block-container absolute-position="absolute" left="91mm" top="55mm" width="92mm" height="22mm" overflow="hidden" font-size="9pt" display-align="after">
                    <fo:block font-family="Liberation Sans" text-transform="uppercase">
                        <fo:inline-container margin="0mm">
                            <fo:block line-height="9pt">${BddAdressePosteeL1}</fo:block>
                            <fo:block line-height="9pt">$!{BddAdressePosteeL2}</fo:block>
                            <fo:block line-height="9pt">$!{BddAdressePosteeL3}</fo:block>
                            <fo:block line-height="9pt">${BddAdressePosteeL4}</fo:block>
                            <fo:block line-height="9pt">$!{BddAdressePosteeL5}</fo:block>
                            <fo:block line-height="9pt">${BddAdressePosteeL6}</fo:block>                      
                        </fo:inline-container>
                    </fo:block>
                </fo:block-container>
                
                <!-- ZONE RESERVE DROITE -->
                <fo:block-container absolute-position="absolute" left="190mm" width="10mm" height="187mm" overflow="hidden">
                    <fo:block/>
                </fo:block-container>
                <fo:block-container absolute-position="absolute" top="40mm" left="187mm" width="13mm" height="24mm" overflow="hidden">
                    <fo:block/>
                </fo:block-container>             
                
                <!-- ZONE RESERVE IMPRIMFIP BAS -->
                <fo:block-container absolute-position="absolute" left="0mm" top="267mm" width="20mm" height="10mm">
                    <fo:table>
                        <fo:table-column column-width="20mm"/>
                        <fo:table-body>
                            <fo:table-row>
                                <fo:table-cell display-align="center" text-align="center" height="10mm">
                                    <fo:block font-weight="bold">&lt;![CDATA[#]]&gt;&lt;![CDATA[#]]&gt;&lt;![CDATA[#]]&gt;</fo:block>
                                </fo:table-cell>
                            </fo:table-row>
                        </fo:table-body>
                    </fo:table>                
                </fo:block-container>
                
                <!-- ZONE TITRE COURRIER -->
                <fo:block-container absolute-position="absolute" left="0.5mm" top="41mm" width="69.5mm" height="100%" overflow="hidden" font-size="10pt">
                    <fo:block line-height="12pt" font-weight="bold" text-align="center">ENTRÉE DANS L’ÉCHANTILLON</fo:block>
                </fo:block-container>
                                
                <!-- ZONE CONTACT -->
                <fo:block-container absolute-position="absolute" left="0.5mm" top="50.5mm" width="69.5mm" height="36.7mm" overflow="hidden">
                    <fo:block>
                        <fo:inline-container>
                            <fo:block font-size="11pt" font-weight="bold">
                                Nous contacter&#160;:&#160; <fo:inline><fo:external-graphic src="coleman/${Enq_ImageContact}" width="5mm" content-height="scale-to-fit" scaling="uniform"/></fo:inline>
                            </fo:block>
                            <fo:block margin-top="1mm">                        
                                <fo:table inline-progression-dimension="auto" table-layout="fixed" display-align="center">
                                    <fo:table-column column-width="7%"/>
                                    <fo:table-column column-width="93%"/>
                                    <fo:table-body>
                                        <fo:table-row>
                                            <fo:table-cell>
                                                <fo:block>
                                                    <fo:external-graphic src="coleman/${Enq_ImageArobase}" width="4mm" height="4mm" content-height="scale-to-fit" content-width="scale-to-fit" scaling="uniform"/>
                                                </fo:block>
                                            </fo:table-cell>
                                            <fo:table-cell>
                                                <fo:block>
                                                    <fo:block language="fr" hyphenate="true" hyphenation-character=" ">#if($!{InitGestionnairesAdresseMessagerie})$!{InitGestionnairesAdresseMessagerie} #else${BddServiceCollecteurAdresseMessagerie}#end </fo:block>
                                                </fo:block>
                                            </fo:table-cell>
                                        </fo:table-row>
                                    </fo:table-body>
                                </fo:table>
                            </fo:block>
                            <fo:block>  
                                #if($!{InitNumeroSVI}||$!{InitGestionnaireTel})
                                <fo:table inline-progression-dimension="auto" table-layout="fixed" display-align="center">
                                    <fo:table-column column-width="7%"/>
                                    <fo:table-column column-width="93%"/>
                                    <fo:table-body>
                                        <fo:table-row>
                                            <fo:table-cell>
                                                <fo:block margin-top="1mm">
                                                    <fo:external-graphic src="coleman/${Enq_ImageTel}" width="4mm" height="4mm" content-height="scale-to-fit" content-width="scale-to-fit" scaling="uniform"/>
                                                </fo:block>
                                            </fo:table-cell>
                                            <fo:table-cell>                                                
                                                <fo:block margin-top="1mm">
                                                    <fo:block>#if($!{InitNumeroSVI})09-69-32-97-47 #elseif($!{InitGestionnaireTel}) $!{InitGestionnaireTel}#end </fo:block>
                                                </fo:block>
                                            </fo:table-cell>
                                        </fo:table-row>
                                    </fo:table-body>
                                </fo:table>
                                #end
                            </fo:block>
                            <fo:block>  
                                #if($!{InitNumeroSVI})
                                <fo:table inline-progression-dimension="auto" table-layout="fixed" display-align="center">
                                    <fo:table-column column-width="7%"/>
                                    <fo:table-column column-width="93%"/>
                                    <fo:table-body>
                                        <fo:table-row>
                                            <fo:table-cell>
                                                <fo:block margin-top="2mm">
                                                </fo:block>
                                            </fo:table-cell>
                                            <fo:table-cell>                                       
                                                <fo:block margin-top="2mm">
                                                    <fo:inline text-decoration="underline">Code enquête</fo:inline>&#160;: $!{InitNumeroSVI}
                                                </fo:block>
                                            </fo:table-cell>
                                        </fo:table-row>
                                    </fo:table-body>
                                </fo:table>
                                #end
                            </fo:block>
                        </fo:inline-container>
                    </fo:block>
                </fo:block-container>

                <!-- ZONE COURRIER -->
                <fo:block-container absolute-position="absolute" left="9mm" top="88mm" width="179mm" height="179mm" overflow="hidden" text-align="justify" font-size="9pt">

                    <fo:block text-align="right" font-size="10pt">
                        Paris, le ${DateEdition}
                    </fo:block>
                    
                    <fo:block margin-top="5mm" font-weight="bold">
                        Objet&#160;: Enquête statistique#if((${BddFrequence}!='annuelle') and (${BddFrequence}!='pluriannuelle') and (${BddFrequence}!='')) ${BddFrequence}#end ${BddLibelleLong}#if((${BddFrequence}!='annuelle') and (${BddFrequence}!='pluriannuelle') and (${BddPeriode}!='')) ${BddPeriode}#end ${BddAnneeReference}
                    </fo:block>
                    <fo:block>
                        Unité enquêtée&#160;: ${BddRaisonSociale} (Votre ${BddLabelUniteEnquetee}&#160;: ${Ue_IdentifiantMetier})
                    </fo:block>
                    
                    <fo:block margin-top="3mm">
                        Identifiant de connexion : <fo:inline font-weight="bold">${BddIdentifiantContact}</fo:inline> (voir modalités au verso de ce courrier)
                    </fo:block>

                    <fo:block margin-top="8mm">
                        #if($!{BddNom} and $!{BddCivilite})$!{BddCivilite} $!{BddNom}, #elseif($!{BddNom}) Madame ou Monsieur $!{BddNom},#else Madame, Monsieur,#end
                    </fo:block>
               
                    <fo:block margin-top="3mm">
                        <fo:inline text-transform="capitalize">${BddArticleServiceProducteur}</fo:inline>${BddNomServiceProducteur} réalise l’enquête #if(${BddFrequence}!='')${BddFrequence}#end ${BddLibelleLong}. ${BddObjectifsLongs}
                    </fo:block>
                    <fo:block margin-top="3mm">
                        Cette enquête#if(${BddCaractereObligatoire}=='oui')<fo:inline font-weight="bold"> à caractère obligatoire</fo:inline>#end est reconnue d'${BddStatutEnquete} par le 
                        Conseil national de l’information statistique (Cnis). Conformément à la loi n° 51-711 du 7 juin 1951 modifiée, les données recueillies sont couvertes par le secret statistique 
                        et ne sauraient en aucun cas être utilisées à des fins de contrôle fiscal ou de répression économique.
                    </fo:block>
                    <fo:block margin-top="3mm">
                        De manière à maintenir une bonne qualité des indicateurs calculés, l’échantillon des unités interrogées est régulièrement renouvelé. 
                        Cette opération nous a conduit à introduire  votre ${BddLabelUniteEnquetee} dans le nouvel échantillon. Vous serez dorénavant sollicité de manière régulière 
                        et il est important que nous puissions recueillir votre réponse afin que la diversité des caractéristiques des entreprises soit prise en compte.
                    </fo:block>
                    <fo:block margin-top="3mm">
                        Je vous invite donc#if(${BddQuestionnaire}==0) à répondre à cette enquête  
                        selon les <fo:inline font-weight="bold">modalités</fo:inline> précisées <fo:inline font-weight="bold">au verso</fo:inline> de cette lettre. 
                        S’il vous est matériellement impossible de répondre en ligne, merci de bien vouloir prendre contact avec notre service d'assistance dont les coordonnées figurent dans l’en-tête de cette 
                        lettre.#else soit à répondre à cette enquête par internet selon les <fo:inline font-weight="bold">modalités</fo:inline> précisées <fo:inline font-weight="bold">au verso</fo:inline> de cette lettre 
                        soit à compléter le questionnaire joint.#end
                    </fo:block>
                    <fo:block margin-top="3mm">
                        Je vous invite à nous transmettre votre questionnaire une fois rempli avant le <fo:inline font-weight="bold">${BddDateEcheance}</fo:inline>. 
                        Notre service d'assistance se tient à votre disposition pour répondre à vos questions en cas de besoin.
                    </fo:block>
                    <fo:block margin-top="3mm">
                        Des renseignements relatifs à l'enquête et à son calendrier sont disponibles sur le site internet du Cnis&#160;: <fo:inline text-decoration="underline">${BddURLCnis}</fo:inline>. #if($!{BddURLDiffusion})
                        Les résultats de cette enquête ou des éditions antérieures sont disponibles sur le site suivant&#160;: <fo:inline text-decoration="underline">$!{BddURLDiffusion}</fo:inline>.#end
                    </fo:block>
                    <fo:block margin-top="3mm">
                        En vous remerciant par avance de votre collaboration, je vous prie de bien vouloir agréer,
                        #if($!{BddNom} and $!{BddCivilite})$!{BddCivilite} $!{BddNom}, #elseif($!{BddNom}) Madame ou Monsieur $!{BddNom},
                        #else Madame, Monsieur,#end l'assurance de ma considération distinguée.
                    </fo:block>
                    
                    <fo:block margin-top="6mm">                        
                        <fo:table inline-progression-dimension="auto" table-layout="fixed" text-align="center" display-align="center">
                            <fo:table-column column-width="89mm"/>
                            <fo:table-column column-width="90mm"/>
                            <fo:table-body>
                                <fo:table-row>
                                    <fo:table-cell number-rows-spanned="2">
                                        <fo:block>
                                            #if($!{Enq_ImageLogoSignataire})
                                            <fo:block text-align="right">
                                                <fo:external-graphic src="coleman/$!{Enq_ImageLogoSignataire}" height="15mm" content-width="scale-to-fit"/>
                                            </fo:block>
                                            #end
                                        </fo:block>
                                    </fo:table-cell>
                                    <fo:table-cell padding-top="4mm">
                                        <fo:block>
                                            ${BddServiceCollecteurSignataireFonction}
                                        </fo:block>
                                    </fo:table-cell>
                                </fo:table-row>
                                <fo:table-row>
                                    <fo:table-cell>
                                        <fo:block display-align="before">
                                            ${BddServiceCollecteurSignataireNom}
                                        </fo:block>
                                    </fo:table-cell>
                                </fo:table-row>
                            </fo:table-body>
                        </fo:table>
                    </fo:block> 
                            
                </fo:block-container>

                <!-- ZONE NOTE DE BAS DE PAGE -->
                <fo:block-container absolute-position="absolute" left="9mm" top="260mm" width="179mm" height="100%" overflow="hidden">
                    <fo:block/>
                </fo:block-container>
                
            </fo:block>
            
            <!-- PAGE COURRIER VERSO -->
            <fo:block page-break-after="always">
                
                <fo:block/>
                
                <!-- Comment répondre -->
                
                #if ($!{CalcMotDePasse})
                <fo:block-container absolute-position="absolute" left="1mm" top="5mm" width="188mm" height="100%" text-align="justify">
                    <fo:block>
                        <fo:external-graphic src="CommentRepondreAvecMdpEntreprises.jpg" width="100%" height="100%" content-height="scale-to-fit" content-width="scale-to-fit" scaling="uniform"/>  
                    </fo:block>
                </fo:block-container>     
                
                <!-- Variables positionnées bloc container superposé à "Comment répondre" -->
                
                <fo:block-container absolute-position="absolute" left="1mm" top="10mm" width="188mm" height="100%" font-size="8pt" text-align="justify">
                    
                    <fo:block margin-top="17.9mm" margin-left="23.5mm" font-size="11pt" font-weight="bold">
                        ${BddLienPlatineEnq}
                    </fo:block>
                    <fo:block margin-top="30.1mm" margin-left="63.5mm" font-size="11pt" font-weight="bold">
                        ${BddIdentifiantContact}
                    </fo:block>
                    <fo:block margin-top="1.9mm" margin-left="63.5mm" font-size="11pt" font-weight="bold">
                        $!{CalcMotDePasse}
                    </fo:block>
                    
                </fo:block-container> 
                
                #else
                <fo:block-container absolute-position="absolute" left="1mm" top="5mm" width="188mm" height="100%" text-align="justify">
                    <fo:block>
                        <fo:external-graphic src="CommentRepondreSansMdpEntreprises.jpg" width="100%" height="100%" content-height="scale-to-fit" content-width="scale-to-fit" scaling="uniform"/>  
                    </fo:block>
                </fo:block-container>
                
                <!-- Variables positionnées bloc container superposé à "Comment répondre" -->
                
                <fo:block-container absolute-position="absolute" left="1mm" top="10mm" width="188mm" height="100%" font-size="8pt" text-align="justify">
                    
                    <fo:block margin-top="19.1mm" margin-left="25mm" font-size="11pt" font-weight="bold">
                        ${BddLienPlatineEnq}
                    </fo:block>
                    <fo:block margin-top="38.3mm" margin-left="63mm" font-size="11pt" font-weight="bold">
                        ${BddIdentifiantContact}
                    </fo:block>
                    
                </fo:block-container> 
                
                #end
                
                <!-- ZONE CADRE LEGAL -->
                <fo:block-container absolute-position="absolute" left="5mm" top="210mm" width="180mm" height="100%" overflow="hidden" font-size="7pt" text-align="justify" border="solid black 0.5pt" padding="1mm">
                    
                    <fo:block>
                        Vu l'avis favorable du Conseil national de l'information statistique, cette enquête est <fo:inline font-weight="bold">reconnue d'${BddStatutEnquete}</fo:inline>, 
                        en application de la loi n<fo:inline font-size="0.1pt">&#160;</fo:inline>°&#160;51-711 du 7 juin 1951 sur l'obligation, la coordination et le secret en matière de statistiques. 
                        Elle a obtenu le visa n°${BddNumeroVisa} du ${BddMinistereTutelle}, valable pour l'année ${BddAnneeCollecte}.
                    </fo:block>
                    <fo:block>
                        #if(${BddCaractereObligatoire}=='oui')Cette enquête est <fo:inline font-weight="bold">obligatoire</fo:inline>. En cas de défaut de réponse après mise en demeure dans le délai imparti ou de réponse sciemment inexacte, 
                        les personnes physiques ou morales peuvent être l'objet d'une amende administrative prononcée par le ministre chargé de l'économie sur avis du 
                        Conseil national de l'information statistique réuni en Comité du contentieux des enquêtes statistiques obligatoires dans les conditions fixées 
                        par le décret prévu au II de l'article 1er bis de la loi du 7 juin 1951.#else<fo:inline font-size="0.1pt">&#160;</fo:inline>Cette enquête n’est pas obligatoire.#end
                    </fo:block>
                    <fo:block>
                        Les informations collectées dans le cadre de cette enquête sont protégées par le secret statistique et destinées à&#160;: ${BddArticleServiceProducteur}${BddNomServiceProducteur}. 
                        Ces réponses ainsi que les données obtenues par appariement seront conservées pendant ${BddConservation} à compter de la fin de la collecte pour les besoins de l’enquête. 
                        Elles seront archivées au-delà de cette durée. À tout moment, leur usage et leur accès seront strictement contrôlés et limités à l'élaboration de statistiques 
                        ou à des travaux de recherche scientifique ou historique.
                    </fo:block>
                    <fo:block>
                        #if(${BddDonneesPerso}=='oui')Le règlement général 2016/679 du 27 avril 2016 sur la protection des données (RGPD) ainsi que la loi 
                        n<fo:inline font-size="0.1pt">&#160;</fo:inline>°&#160;78-17 du 6 janvier 1978 relative à l'informatique, 
                        aux fichiers et aux libertés s'appliquent à la présente enquête. Pour les données à caractère personnel, un droit d'accès, de rectification 
                        ou de limitation de traitement peut être exercé pendant la période de conservation des données d’identification. 
                        Ces droits peuvent être exercés auprès de ${AdresseRetourL1} que vous pouvez contacter à l’adresse ${BddServiceCollecteurAdresseMessagerie}. 
                        Pour toute question relative au traitement de vos données, vous pouvez contacter 
                        #if($!{InfoRGPDNonInsee})$!{InfoRGPDNonInsee}.
                        #{else}le délégué à la protection des données des ministères économique 
                        et financier à l’adresse <fo:inline text-decoration="underline">le-delegue-a-la-protection-des-donnees-personnelles@finances.gouv.fr</fo:inline> 
                        ou son correspondant à l’Insee : <fo:inline text-decoration="underline">contact-rgpd@insee.fr</fo:inline>.#end 
                        Vous pouvez si vous l’estimez nécessaire adresser une réclamation à la Cnil.#end
                    </fo:block>
                    
                </fo:block-container>
            
            </fo:block>
            
        </fo:flow>
